# --- HTTP-API ---------------------------------------------------------------

# Порт HTTP-API оркестратора.
CORE_PORT=8080

# Интерфейс, на котором слушает сервис. 0.0.0.0 нужен, чтобы Core был доступен
# другим контейнерам compose-сети; наружу порт не публикуется.
CORE_HOST=0.0.0.0

# Предел размера тела запроса в байтах. Сообщения пользователей заведомо
# меньше, лимит защищает от случайного или намеренного мусора.
CORE_MAX_BODY_BYTES=65536

# Общий секрет между Core и адаптерами. Должен совпадать с CORE_AUTH_TOKEN
# адаптера. Защищает /v1/* от посторонних и подписывает исходящие callback'и.
# Если оставить пустым, проверка выключается — так можно только локально.
CORE_AUTH_TOKEN=

# --- Хранилище --------------------------------------------------------------

# Путь к файлу базы данных SQLite: история диалогов и очередь заданий.
# Относительные пути считаются от корня сервиса, а не от текущего каталога.
SQLITE_DB_PATH=./data/core.db

# Размер контекстного окна диалога в токенах. Считается по фактическим данным
# токенайзера модели (prompt_eval_count + eval_count) и передаётся в Ollama
# как num_ctx. При достижении лимита Core отвечает адаптеру отказом с
# причиной context_limit — пользователю нужно начать новый диалог.
#
# Значение не должно превышать нативное окно модели: у qwen3:8b это 32768
# токенов (проверить своё — `ollama show <модель>`). Но упирается оно раньше,
# в память: KV-кеш qwen3:8b занимает примерно 144 КиБ на токен, поэтому 16000
# токенов стоят около 2.3 ГБ поверх ~5 ГБ самих весов — на карте с 12 ГБ это
# с запасом. Полные 32768 добавили бы ещё ~2.4 ГБ и пошли бы впритык.
# Загруженный размер видно командой `ollama ps`.
CONTEXT_WINDOW_TOKENS=16000

# --- Модель -----------------------------------------------------------------

# Провайдер локальной LLM. Пока поддерживается только "ollama".
LLM_PROVIDER=ollama

# Если Core запускается в Docker, а Ollama установлена на хост-машине —
# используйте http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Максимальное время ожидания ответа модели, мс. Двух минут хватает для 8B на
# видеокарте даже на длинный ответ; большее значение лишь дольше держит
# зависшее задание в работе. Без GPU счёт идёт на минуты — увеличьте.
OLLAMA_TIMEOUT_MS=120000

# Режим «размышления» гибридных reasoning-моделей (Qwen3 и подобных). У Qwen3
# он включён по умолчанию, и рассуждения приезжают в теле ответа блоком
# <think>…</think>: они ушли бы пользователю, засорили историю и раздули
# счётчик токенов. Core такие блоки в любом случае вырезает, но дешевле
# не генерировать их вовсе.
#   false — отключить (по умолчанию)
#   true  — включить
#   omit  — не передавать поле совсем; нужно для моделей без поддержки
#           размышления (llama3 и т.п.), они отвергают запрос с ним
OLLAMA_THINK=false

# --- Сбор рыночных данных ---------------------------------------------------

# Адрес публичного API Binance. Инструменты работают только с открытыми
# эндпоинтами: ни ключей, ни подписи, ни доступа к средствам. Адрес держится
# в конфиге, а не в параметрах вызова: параметры формирует языковая модель.
BINANCE_BASE_URL=https://api.binance.com

# Максимальное время ожидания ответа биржи, мс.
TOOLS_TIMEOUT_MS=10000

# --- Доставка ответов адаптерам ---------------------------------------------

# Куда Core отправляет готовый ответ для адаптера telegram. Адрес держится
# в конфиге, а не приходит в запросе: иначе сервис можно было бы заставить
# слать запросы куда угодно.
ADAPTER_TELEGRAM_CALLBACK_URL=http://telegram-bot:8081/callbacks/replies

# Сколько раз пытаться доставить результат и с какой стартовой паузой (мс).
# Пауза удваивается с каждой неудачей; расписание хранится в БД, поэтому
# переживает перезапуск Core.
CALLBACK_MAX_ATTEMPTS=6
CALLBACK_BACKOFF_MS=2000
CALLBACK_TIMEOUT_MS=10000

# Как часто опрашивать очередь заданий, мс.
JOB_POLL_INTERVAL_MS=500
