# --- HTTP-API ---------------------------------------------------------------

# Порт HTTP-API оркестратора.
CORE_PORT=8080

# Интерфейс, на котором слушает сервис. 0.0.0.0 нужен, чтобы Core был доступен
# другим контейнерам compose-сети; наружу порт не публикуется.
CORE_HOST=0.0.0.0

# Предел размера тела запроса в байтах. Сообщения пользователей заведомо
# меньше, лимит защищает от случайного или намеренного мусора.
CORE_MAX_BODY_BYTES=65536

# Общий секрет между Core и адаптерами. Должен совпадать с CORE_AUTH_TOKEN
# адаптера. Защищает /v1/* от посторонних и подписывает исходящие callback'и.
# Если оставить пустым, проверка выключается — так можно только локально.
CORE_AUTH_TOKEN=

# --- Хранилище --------------------------------------------------------------

# Путь к файлу базы данных SQLite: история диалогов и очередь заданий.
# Относительные пути считаются от корня сервиса, а не от текущего каталога.
SQLITE_DB_PATH=./data/core.db

# Размер контекстного окна диалога в токенах. Считается по фактическим данным
# токенайзера модели (у Ollama — prompt_eval_count + eval_count, у LM Studio —
# usage.prompt_tokens + usage.completion_tokens). При достижении лимита Core
# отвечает адаптеру отказом с причиной context_limit — пользователю нужно
# начать новый диалог.
#
# Значение не должно превышать нативное окно модели и должно совпадать с тем,
# что реально загружено:
#   - Ollama: передаётся моделью как num_ctx на каждый запрос. Нативное окно
#     модели — `ollama show <модель>`, загруженный размер — `ollama ps`.
#   - LM Studio: раннер num_ctx не передаёт — этого поля нет в его HTTP API.
#     Длину контекста задают один раз при загрузке модели (вкладка Developer
#     → настройки модели → Context Length, либо `lms load <модель>
#     --context-length N`). Выставьте её там не меньше значения ниже, иначе
#     LM Studio молча обрежет историю раньше, чем сработает наш лимит.
CONTEXT_WINDOW_TOKENS=16000

# --- Модель -----------------------------------------------------------------

# Провайдер локальной LLM: "ollama" или "lmstudio".
LLM_PROVIDER=lmstudio

# --- LM Studio ---

# Адрес встроенного HTTP-сервера LM Studio (вкладка Developer → Start
# Server, порт по умолчанию 1234). Если Core запускается в Docker, а
# LM Studio — на хост-машине, используйте http://host.docker.internal:1234
LMSTUDIO_BASE_URL=http://localhost:1234

# Идентификатор модели ровно в том виде, в котором его знает LM Studio (не
# всегда совпадает с названием в интерфейсе) — уточнить можно запросом
# `curl http://localhost:1234/v1/models` при запущенном сервере и
# загруженной модели, либо во вкладке My Models.
LMSTUDIO_MODEL=bonsai-27b

# Максимальное время ожидания ответа модели, мс.
#
# Пять минут, а не две: bonsai-27b даже в четырёхбитном кванте не помещается
# в 12 ГБ видеопамяти целиком, уходит в частичный расчёт на процессоре и на
# длинном ответе (сводка по рынку — таблица на десять строк плюс текст)
# считает минутами. Слишком малое значение здесь не ускоряет ответ, а лишь
# выбрасывает уже проделанную работу.
#
# Поднимая это значение, поднимите и CORE_OVERVIEW_TIMEOUT_MS в telegram-bot:
# адаптер не должен сдаваться раньше, чем сдастся Core.
LMSTUDIO_TIMEOUT_MS=300000

# --- Ollama (альтернативный провайдер, LLM_PROVIDER=ollama) ---

# Если Core запускается в Docker, а Ollama установлена на хост-машине —
# используйте http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Максимальное время ожидания ответа модели, мс. Двух минут хватает для 8B на
# видеокарте даже на длинный ответ; большее значение лишь дольше держит
# зависшее задание в работе. Без GPU счёт идёт на минуты — увеличьте.
OLLAMA_TIMEOUT_MS=120000

# Режим «размышления» гибридных reasoning-моделей (Qwen3 и подобных). У Qwen3
# он включён по умолчанию, и рассуждения приезжают в теле ответа блоком
# <think>…</think>: они ушли бы пользователю, засорили историю и раздули
# счётчик токенов. Core такие блоки в любом случае вырезает, но дешевле
# не генерировать их вовсе. Актуально только для Ollama — в HTTP API LM
# Studio нет стандартизованного поля для переключения размышления.
#   false — отключить (по умолчанию)
#   true  — включить
#   omit  — не передавать поле совсем; нужно для моделей без поддержки
#           размышления (llama3 и т.п.), они отвергают запрос с ним
OLLAMA_THINK=false

# --- Сбор рыночных данных ---------------------------------------------------

# Адрес публичного API Binance. Инструменты работают только с открытыми
# эндпоинтами: ни ключей, ни подписи, ни доступа к средствам. Адрес держится
# в конфиге, а не в параметрах вызова: параметры формирует языковая модель.
BINANCE_BASE_URL=https://api.binance.com

# Адрес публичного API CoinGecko — источник рыночной капитализации. Нужен по
# существу, а не для подстраховки: Binance знает торговые пары и их объёмы,
# но не знает, сколько монет выпущено, — рейтинга «топ по капитализации»
# из неё не получить. На нём держатся команда /start и инструмент
# get_crypto_market_overview; без переменной инструмент просто не появляется
# в реестре, остальные продолжают работать.
#
# Ключа не требует, но у бесплатного тарифа низкий лимит частоты: обзор
# рынка поэтому кешируется на минуту (TTL.overview в core/src/tools/index.js).
COINGECKO_BASE_URL=https://api.coingecko.com

# Максимальное время ожидания ответа биржи, мс.
TOOLS_TIMEOUT_MS=10000

# --- Расчёт индикаторов (RSI) ---

# Считать ли RSI. Показатель считает Python-скрипт scripts/rsi/rsi.py поверх
# TA-Lib; зависимости ставятся так:
#
#     pip install -r core/scripts/rsi/requirements.txt
#
# Интерпретатор Core находит сам: сначала python3 из PATH (активированный venv
# подменяет его своим), затем .venv рядом с сервисом и ~/.venv. Кандидат
# принимается, только если в нём импортируется TA-Lib, — иначе инструмент RSI
# просто не попадает в реестр, и планировщик не тратит на него шаг.
#
# RSI_ENABLED=false убирает инструмент из реестра, даже когда библиотека есть.
RSI_ENABLED=true

# Запасной выход для нестандартной установки Python (conda, pyenv,
# интерпретатор в неожиданном месте): путь берётся отсюда и поиск не
# выполняется. В обычных случаях оставьте закомментированным — путь придётся
# менять на каждой машине, а в Docker этот же файл читает и контейнер, где
# путей с хоста нет.
# RSI_PYTHON_BIN=/opt/venv/bin/python

# Максимальное время работы скрипта расчёта, мс. Сам расчёт занимает доли
# секунды; предел нужен на случай, если интерпретатор чего-то ждёт.
RSI_TIMEOUT_MS=30000

# --- Доставка ответов адаптерам ---------------------------------------------

# Куда Core отправляет готовый ответ для адаптера telegram. Адрес держится
# в конфиге, а не приходит в запросе: иначе сервис можно было бы заставить
# слать запросы куда угодно.
ADAPTER_TELEGRAM_CALLBACK_URL=http://telegram-bot:8081/callbacks/replies

# Сколько раз пытаться доставить результат и с какой стартовой паузой (мс).
# Пауза удваивается с каждой неудачей; расписание хранится в БД, поэтому
# переживает перезапуск Core.
CALLBACK_MAX_ATTEMPTS=6
CALLBACK_BACKOFF_MS=2000
CALLBACK_TIMEOUT_MS=10000

# Как часто опрашивать очередь заданий, мс.
JOB_POLL_INTERVAL_MS=500
