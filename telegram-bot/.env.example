# Токен бота, выданный @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Провайдер локальной LLM. Пока поддерживается только "ollama".
LLM_PROVIDER=ollama

# Максимальная длина текстового сообщения от пользователя (в символах).
# Более длинные сообщения отклоняются с предупреждением, без обращения к LLM.
MAX_MESSAGE_LENGTH=1000

# Путь к файлу базы данных SQLite, где хранится история переписки.
# Каталог создаётся автоматически, если ещё не существует.
# В Docker путь по умолчанию (./data/bot.db) указывает на volume — см. docker-compose.yml.
SQLITE_DB_PATH=./data/bot.db

# Размер контекстного окна диалога в токенах (считается по данным токенайзера
# модели Ollama: prompt_eval_count + eval_count). При достижении лимита бот
# попросит пользователя начать новый диалог командой /new.
CONTEXT_WINDOW_TOKENS=50000

# Настройки Ollama
# Если бот запускается локально (npm start) — оставьте localhost.
# Если бот запускается в Docker (docker compose), а Ollama установлена
# на хост-машине — используйте http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
