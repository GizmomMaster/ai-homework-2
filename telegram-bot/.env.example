# Токен бота, выданный @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Максимальная длина текстового сообщения от пользователя (в символах).
# Более длинные сообщения отклоняются с предупреждением, не доходя до Core.
MAX_MESSAGE_LENGTH=1000

# --- Связь с Core Orchestrator ----------------------------------------------
# Адаптер не обращается к модели напрямую: он передаёт сообщения в Core и
# получает готовые ответы обратно на свой callback-эндпоинт.

# Адрес Core. При запуске через docker compose это имя сервиса в сети compose.
CORE_BASE_URL=http://core:8080

# Общий секрет с Core; должен совпадать с CORE_AUTH_TOKEN на его стороне.
# Подписывает исходящие запросы и проверяется на входящих callback'ах, чтобы
# бот не отправил пользователю «ответ модели» от постороннего источника.
CORE_AUTH_TOKEN=

# Core отвечает сразу, не дожидаясь модели, поэтому таймаут здесь небольшой.
# Повторы нужны в основном на случай, что Core ещё поднимается.
CORE_TIMEOUT_MS=10000
CORE_RETRIES=3
CORE_RETRY_DELAY_MS=1000

# Отдельный таймаут на сводку по рынку для /start. Core собирает её прямо в
# запросе: поход в Binance и CoinGecko плюс вызов модели, которая пишет текст.
#
# Должен перекрывать то, сколько Core разрешено на это потратить, то есть
# LMSTUDIO_TIMEOUT_MS (120 с) плюс TOOLS_TIMEOUT_MS — иначе адаптер сдастся
# раньше, чем сдастся Core, и генерация пропадёт впустую. Поднимая таймаут
# модели в core/.env, поднимите и этот.
#
# Повторов у этого запроса нет: истёкший таймаут значит «модель пишет
# медленно», а повтор заставил бы её начать заново.
CORE_OVERVIEW_TIMEOUT_MS=150000

# Локальный сервер, на который Core доставляет готовые ответы. Значение должно
# совпадать с ADAPTER_TELEGRAM_CALLBACK_URL в конфигурации Core.
CALLBACK_PORT=8081
CALLBACK_HOST=0.0.0.0
CALLBACK_PATH=/callbacks/replies

# Адрес Telegram Bot API. Менять нужно только для сквозных тестов или
# локального прокси — в обычной работе оставьте значение по умолчанию.
# TELEGRAM_API_BASE_URL=https://api.telegram.org
