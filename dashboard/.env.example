# Порт и интерфейс дашборда.
DASHBOARD_PORT=8090
DASHBOARD_HOST=0.0.0.0

# Путь к файлу БД Core (той же, что core/src/db/database.js — llm_calls,
# tool_calls, jobs). Дашборд открывает её только на чтение. В docker-compose
# путь приходит из общего volume ./core/data, при локальном запуске рядом с
# core/ можно оставить значение по умолчанию.
DASHBOARD_DB_PATH=../core/data/core.db

# Те же условные цены, что core/.env — используются только для подписи под
# суммой стоимости на странице (сама сумма уже посчитана и хранится в БД).
TELEMETRY_PRICE_INPUT_PER_1M=3
TELEMETRY_PRICE_OUTPUT_PER_1M=15
